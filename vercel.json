{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fraud-detection-backend.up.railway.app/api/$1"
    },
    {
      "source": "/ws",
      "destination": "https://fraud-detection-backend.up.railway.app/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
